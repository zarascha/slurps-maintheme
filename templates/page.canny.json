    "custom_html_JbpKqN": {
      "type": "custom-html",
      "name": "Canny Pixel Runner",
      "settings": {
        "full_width": false,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "html": "<style>\n  .canpan-runner-legend { display: block; }\n  .canpan-runner-mobile-controls { display: none !important; }\n  \n  #canpan-canny-pixel-runner-canvas {\n    display: block;\n    width: 100%;\n    height: 300px;\n    touch-action: none;\n    user-select: none;\n  }\n\n  @media (max-width: 768px) {\n    .canpan-runner-legend { display: none !important; }\n    \n    .canpan-runner-mobile-controls { \n      display: flex !important; \n    }\n    \n    #canpan-canny-pixel-runner-canvas {\n      height: 210px !important;\n      aspect-ratio: auto !important; \n    }\n  }\n\n  .canpan-runner-help-container {\n    position: relative;\n    z-index: 20;\n    pointer-events: auto;\n  }\n\n  .canpan-runner-help-container .canpan-runner-legend {\n    position: absolute;\n    top: 100%;\n    right: 0;\n    margin-top: 8px;\n    width: max-content;\n    opacity: 0;\n    transform: translateY(-5px);\n    transition: all 0.2s ease-in-out;\n    pointer-events: none;\n  }\n\n  .canpan-runner-help-container:hover .canpan-runner-legend {\n    opacity: 1;\n    transform: translateY(0);\n  }\n</style>\n\n<div id=\"canpan-canny-pixel-runner\" style=\"width:100%; margin:24px 0; position:relative;\">\n  \n  <div style=\"border:1px solid rgba(0,0,0,.15); overflow:hidden; width:100%; position:relative; border-radius:12px; background:#000;\">\n\n    <canvas id=\"canpan-canny-pixel-runner-canvas\"></canvas>\n\n    <div style=\"position:absolute; top:10px; right:10px; display:flex; gap:12px; align-items:flex-start; z-index:20;\">\n      \n      <div id=\"canpan-canny-pixel-runner-hud\" style=\"\n          display:flex; gap:12px; align-items:center; height: 34px; box-sizing: border-box;\n          padding:0 12px; background:rgba(255,255,255,0.88); border:1px solid rgba(0,0,0,0.18);\n          border-radius:10px; user-select:none; pointer-events:none;\n          font-family:'Poppins', sans-serif; font-size:12px; line-height:1; font-weight:600;\n          letter-spacing:0.06em; text-transform:uppercase; box-shadow:0 6px 18px rgba(0,0,0,0.08);\n        \">\n        <span>SC <span id=\"canpan-canny-pixel-runner-score\">0</span></span>\n        <span>HI <span id=\"canpan-canny-pixel-runner-best\">0</span></span>\n      </div>\n\n      <div class=\"canpan-runner-help-container\">\n        <div style=\"\n            display:flex; align-items:center; justify-content:center;\n            height: 34px; width: 34px; box-sizing: border-box;\n            background:rgba(255,255,255,0.88); border:1px solid rgba(0,0,0,0.18);\n            border-radius:10px; cursor:help; font-family:'Poppins', sans-serif; font-size:16px; \n            font-weight:700; color:#333; box-shadow:0 6px 18px rgba(0,0,0,0.08); user-select:none;\n        \">?</div>\n        \n        <div class=\"canpan-runner-legend\" style=\"\n            background:rgba(255,255,255,0.92); padding:10px 14px; border-radius:10px;\n            font-family:'Poppins', sans-serif; font-size:11px; line-height:1.6; color:#333;\n            border:1px solid rgba(0,0,0,0.18); backdrop-filter:blur(4px);\n            box-shadow:0 6px 18px rgba(0,0,0,0.12); text-transform:none; letter-spacing:normal;\n          \">\n          <b>[W] / [↑] / [Space]</b>: Springen<br>\n          <b>[S] / [↓]</b>: Ducken<br>\n          <b>[P]</b>: Pause<br>\n          <b><br>\n          <b>Canny Pixel Runner by CANPAN™<br>\n        </b></b>\n</div>\n<b><b>\n      </b></b>\n</div>\n<b><b>\n      \n    </b></b>\n</div>\n<b><b>\n\n    <div id=\"canpan-canny-pixel-runner-start-overlay\" style=\"\n        position:absolute; inset:0; display:flex; align-items:center; justify-content:center;\n        background:rgba(255,255,255,0.55); backdrop-filter: blur(2px); z-index:10;\n      \">\n      <button id=\"canpan-canny-pixel-runner-btn-start\" type=\"button\" style=\"\n          font-family:'Poppins', sans-serif; font-size:16px; font-weight:700;\n          letter-spacing:0.08em; text-transform:uppercase; padding:16px 24px; border-radius:12px;\n          border:1px solid rgba(0,0,0,0.22); background:#ffffff; cursor:pointer;\n          box-shadow:0 10px 24px rgba(0,0,0,0.15); transition: transform 0.1s;\n        \">\n        Start\n      </button>\n    </div>\n\n  </b></b>\n</div>\n<b><b> \n  \n  <div class=\"canpan-runner-mobile-controls\" style=\"margin-top: 12px; gap: 12px; justify-content: space-between; width: 100%;\">\n    <button id=\"canpan-canny-pixel-runner-btn-duck\" type=\"button\" style=\"\n        flex: 1; height: 64px; display: flex; align-items: center; justify-content: center; gap: 8px;\n        background: #f5f5f5; border: 2px solid rgba(0,0,0,0.15); border-radius: 12px;\n        font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: bold; color: #333;\n        touch-action: manipulation; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.05);\n      \">\n       <span style=\"font-size: 14px; text-transform: uppercase;\">Ducken</span>\n    </button>\n      \n    <button id=\"canpan-canny-pixel-runner-btn-jump\" type=\"button\" style=\"\n        flex: 1; height: 64px; display: flex; align-items: center; justify-content: center; gap: 8px;\n        background: #f5f5f5; border: 2px solid rgba(0,0,0,0.15); border-radius: 12px;\n        font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: bold; color: #333;\n        touch-action: manipulation; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.05);\n      \">\n      <span style=\"font-size: 14px; text-transform: uppercase;\">Springen</span>\n    </button>\n  </div>\n\n</b></b>\n</div><b><b>\n\n<script>\n(function () {\n  if (window.__CANPAN_CANNY_PIXEL_RUNNER_INIT__) return;\n  window.__CANPAN_CANNY_PIXEL_RUNNER_INIT__ = true;\n\n  // ====== DOM ======\n  const canvas = document.getElementById(\"canpan-canny-pixel-runner-canvas\");\n  const scoreEl = document.getElementById(\"canpan-canny-pixel-runner-score\");\n  const bestEl  = document.getElementById(\"canpan-canny-pixel-runner-best\");\n\n  const btnStart  = document.getElementById(\"canpan-canny-pixel-runner-btn-start\");\n  const startOverlay = document.getElementById(\"canpan-canny-pixel-runner-start-overlay\");\n\n  const btnJump = document.getElementById(\"canpan-canny-pixel-runner-btn-jump\");\n  const btnDuck = document.getElementById(\"canpan-canny-pixel-runner-btn-duck\");\n\n  if (!canvas || !canvas.getContext) return;\n  const ctx = canvas.getContext(\"2d\");\n  ctx.imageSmoothingEnabled = false; \n\n  // ====== CONFIG ======\n  let VIRTUAL_W = 900;     \n  const VIRTUAL_H = 300;   \n  const PLAYER_START_PERCENT = 0.20; \n\n  const groundY = 245; \n  const gravity = 2450;\n  const jumpVel = -840;\n\n  const COYOTE_MAX = 0.08;\n  const JUMP_BUFFER_MAX = 0.12;\n  const FALL_BOOST = 1.6; \n  const TRANSITION_SECONDS = 4.0;\n\n  // ====== THEMES ======\n  const THEMES = [\n    { at: 0,    sky:\"#e7c77d\", sun:\"#ffffff\", dunesAlpha:0.18, ground:\"#d7a85a\", groundLine:\"#1b1b1b\", tickAlpha:0.22, palmAlpha:0.22, pyramidFill:\"#cfa55a\", pyramidShadeAlpha:0.18, pyramidOutline:\"#111111\", dustAlpha:0.35, bird:\"#111111\" },\n    { at: 500,  sky:\"#f2b07e\", sun:\"#fff3e3\", dunesAlpha:0.20, ground:\"#c78f53\", groundLine:\"#1b1b1b\", tickAlpha:0.22, palmAlpha:0.22, pyramidFill:\"#c48a4e\", pyramidShadeAlpha:0.22, pyramidOutline:\"#111111\", dustAlpha:0.35, bird:\"#111111\" },\n    { at: 1500, sky:\"#27304a\", sun:\"#dfe8ff\", dunesAlpha:0.22, ground:\"#6b5b3f\", groundLine:\"#10131d\", tickAlpha:0.28, palmAlpha:0.30, pyramidFill:\"#7a6a4f\", pyramidShadeAlpha:0.32, pyramidOutline:\"#0b0d13\", dustAlpha:0.28, bird:\"#dfe8ff\" },\n    { at: 3000, sky:\"#1a0f2e\", sun:\"#e8fffb\", dunesAlpha:0.20, ground:\"#2b1f44\", groundLine:\"#e8fffb\", tickAlpha:0.22, palmAlpha:0.35, pyramidFill:\"#4a2c7a\", pyramidShadeAlpha:0.40, pyramidOutline:\"#e8fffb\", dustAlpha:0.30, bird:\"#e8fffb\" }\n  ];\n\n  // ====== Helpers ======\n  function hexToRgb(hex) {\n    const h = hex.replace(\"#\",\"\").trim();\n    const full = (h.length === 3) ? h.split(\"\").map(ch => ch + ch).join(\"\") : h;\n    const n = parseInt(full, 16);\n    return { r:(n>>16)&255, g:(n>>8)&255, b:n&255 };\n  }\n  function lerp(a,b,t){ return a + (b-a)*t; }\n  function clamp01(x){ return Math.max(0, Math.min(1, x)); }\n  function smoothstep(t){ t = clamp01(t); return t*t*(3-2*t); }\n  function mixHex(a,b,t){\n    const A=hexToRgb(a), B=hexToRgb(b);\n    return `rgb(${Math.round(lerp(A.r,B.r,t))},${Math.round(lerp(A.g,B.g,t))},${Math.round(lerp(A.b,B.b,t))})`;\n  }\n  function mixNum(a,b,t){ return lerp(a,b,t); }\n  function rand(min, max) { return Math.random() * (max - min) + min; }\n  function pxRect(x, y, w, h, color) { ctx.fillStyle = color; ctx.fillRect(x, y, w, h); }\n  \n  function drawRoundRect(ctx, x, y, width, height, radius) {\n    ctx.beginPath();\n    ctx.moveTo(x + radius, y);\n    ctx.lineTo(x + width - radius, y);\n    ctx.quadraticCurveTo(x + width, y, x + width, y + radius);\n    ctx.lineTo(x + width, y + height - radius);\n    ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);\n    ctx.lineTo(x + radius, y + height);\n    ctx.quadraticCurveTo(x, y + height, x, y + height - radius);\n    ctx.lineTo(x, y + radius);\n    ctx.quadraticCurveTo(x, y, x + radius, y);\n    ctx.closePath();\n  }\n\n  // ====== Theme blending ======\n  let themeIdx = 0, themeFrom = THEMES[0], themeTo = THEMES[0], inTransition = false, transitionT = 0, activeTheme = { ...THEMES[0] };\n\n  function snapshotTheme() {\n    return { sky: activeTheme.sky, sun: activeTheme.sun, dunesAlpha: activeTheme.dunesAlpha, ground: activeTheme.ground, groundLine: activeTheme.groundLine, tickAlpha: activeTheme.tickAlpha, palmAlpha: activeTheme.palmAlpha, pyramidFill: activeTheme.pyramidFill, pyramidShadeAlpha: activeTheme.pyramidShadeAlpha, pyramidOutline: activeTheme.pyramidOutline, dustAlpha: activeTheme.dustAlpha, bird: activeTheme.bird };\n  }\n  function startThemeTransition(nextIdx) {\n    themeFrom = snapshotTheme(); themeTo = THEMES[nextIdx]; inTransition = true; transitionT = 0; themeIdx = nextIdx;\n  }\n  function updateTheme(dt, score) {\n    if (!inTransition) {\n      for (let i = THEMES.length - 1; i >= 0; i--) {\n        if (score >= THEMES[i].at) {\n          if (i !== themeIdx) startThemeTransition(i);\n          break;\n        }\n      }\n    }\n    if (inTransition) {\n      transitionT += dt / Math.max(0.001, TRANSITION_SECONDS);\n      const t = smoothstep(transitionT);\n      activeTheme.sky = mixHex(themeFrom.sky, themeTo.sky, t); activeTheme.sun = mixHex(themeFrom.sun, themeTo.sun, t); activeTheme.ground = mixHex(themeFrom.ground, themeTo.ground, t); activeTheme.groundLine = mixHex(themeFrom.groundLine, themeTo.groundLine, t); activeTheme.pyramidFill = mixHex(themeFrom.pyramidFill, themeTo.pyramidFill, t); activeTheme.pyramidOutline = mixHex(themeFrom.pyramidOutline, themeTo.pyramidOutline, t); activeTheme.bird = mixHex(themeFrom.bird, themeTo.bird, t);\n      activeTheme.dunesAlpha = mixNum(themeFrom.dunesAlpha, themeTo.dunesAlpha, t); activeTheme.tickAlpha = mixNum(themeFrom.tickAlpha, themeTo.tickAlpha, t); activeTheme.palmAlpha = mixNum(themeFrom.palmAlpha, themeTo.palmAlpha, t); activeTheme.dustAlpha = mixNum(themeFrom.dustAlpha, themeTo.dustAlpha, t); activeTheme.pyramidShadeAlpha = mixNum(themeFrom.pyramidShadeAlpha, themeTo.pyramidShadeAlpha, t);\n      if (transitionT >= 1) { inTransition = false; activeTheme = { ...THEMES[themeIdx] }; }\n    } else { activeTheme = { ...THEMES[themeIdx] }; }\n  }\n\n  // ====== Canvas Sizing ======\n  let backingStoreScale = 1;\n  function resizeBackingStore() {\n    const cssW = canvas.clientWidth || 320;\n    const cssH = canvas.clientHeight || 300;\n    const dpr = window.devicePixelRatio || 1;\n    const targetW = Math.round(cssW * dpr);\n    const targetH = Math.round(cssH * dpr);\n\n    if (canvas.width !== targetW || canvas.height !== targetH) {\n      canvas.width = targetW;\n      canvas.height = targetH;\n    }\n    VIRTUAL_W = (cssW / cssH) * VIRTUAL_H;\n    backingStoreScale = targetH / VIRTUAL_H;\n  }\n\n  // ====== Game state ======\n  const BEST_KEY = \"canpan_canny_pixel_runner_best_v1\";\n  let bestScore = Number(localStorage.getItem(BEST_KEY) || 0);\n  bestEl.textContent = bestScore;\n\n  let tPrev = performance.now(), rafId = null;\n  let started = false, playing = false, paused = false, gameOver = false;\n  let speed = 430, distance = 0, score = 0, coyote = 0, jumpBuffer = 0, ducking = false;\n  const speedInc = 10;\n  const pyramids = [], birds = [], palms = [], dust = [];\n  \n  // Spieler-Objekt mit Comment-System\n  const player = { x: 0, y: groundY, vy: 0, onGround: true, anim: 0, comment: null, commentTimer: 0, lastCommentScore: -1 };\n  \n  let pyramidTimer = 0, pyramidEveryMin = 0.9, pyramidEveryMax = 1.6;\n  let birdTimer = 0, birdEveryMin = 1.1, birdEveryMax = 2.0;\n\n  function canSpawnObstacleAt(newX) {\n    const jumpDuration = 0.75;\n    const minDynamicGap = speed * jumpDuration + 60; \n    for (const p of pyramids) if (Math.abs(newX - p.x) < minDynamicGap) return false;\n    for (const b of birds) if (Math.abs(newX - b.x) < minDynamicGap) return false;\n    return true;\n  }\n\n  function spawnPyramid() {\n    const x = VIRTUAL_W + 40;\n    if (!canSpawnObstacleAt(x)) { pyramidTimer = 0.25; return; }\n    pyramids.push({ x, baseY: groundY, size: rand(28, 52), widthMul: Math.random() < 0.35 ? rand(1.15, 1.35) : rand(0.95, 1.1) });\n  }\n\n  function spawnBird() {\n    const x = VIRTUAL_W + 50;\n    if (!canSpawnObstacleAt(x)) { birdTimer = 0.25; return; }\n    const r = Math.random();\n    let y = (r < 0.55) ? groundY - 36 : (r < 0.85 ? groundY - 70 : groundY - 100);\n    birds.push({ x, y, w: 34, h: 14, flap: 0 });\n  }\n\n  // ====== Controls ======\n  function setBestIfNeeded() {\n    if (score > bestScore) { bestScore = score; bestEl.textContent = bestScore; localStorage.setItem(BEST_KEY, String(bestScore)); }\n  }\n\n  function 