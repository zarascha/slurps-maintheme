\n      ctx.stroke();\n\n      ctx.beginPath();\n      ctx.moveTo(bubbleX + bubbleW / 2 - 8, bubbleY + bubbleH);\n      ctx.lineTo(bubbleX + bubbleW / 2, bubbleY + bubbleH + 10);\n      ctx.lineTo(bubbleX + bubbleW / 2 + 8, bubbleY + bubbleH);\n      ctx.fill();\n      ctx.stroke();\n      \n      ctx.beginPath();\n      ctx.moveTo(bubbleX + bubbleW / 2 - 7, bubbleY + bubbleH);\n      ctx.lineTo(bubbleX + bubbleW / 2 + 7, bubbleY + bubbleH);\n      ctx.strokeStyle = \"#ffffff\";\n      ctx.stroke();\n\n      ctx.fillStyle = \"#111111\";\n      ctx.textAlign = \"center\";\n      ctx.textBaseline = \"middle\";\n      ctx.fillText(player.comment, bubbleX + bubbleW / 2, bubbleY + bubbleH / 2 + 1);\n      ctx.restore();\n    }\n  }\n\n  // ====== Drawing ======\n  function drawBackground() {\n    ctx.fillStyle = activeTheme.sky; ctx.fillRect(0, 0, VIRTUAL_W, VIRTUAL_H);\n    ctx.globalAlpha = 0.22; ctx.fillStyle = activeTheme.sun; ctx.beginPath(); ctx.arc(VIRTUAL_W-170, 70, 34, 0, Math.PI*2); ctx.fill(); ctx.globalAlpha = 1;\n    ctx.globalAlpha = activeTheme.dunesAlpha; ctx.fillStyle = \"#000\"; ctx.beginPath(); \n    \n    ctx.moveTo(0, 190); \n    ctx.quadraticCurveTo(VIRTUAL_W*0.16, 160, VIRTUAL_W*0.30, 190); \n    ctx.quadraticCurveTo(VIRTUAL_W*0.48, 225, VIRTUAL_W*0.70, 190); \n    ctx.quadraticCurveTo(VIRTUAL_W*0.84, 165, VIRTUAL_W, 195); \n    ctx.lineTo(VIRTUAL_W, groundY); ctx.lineTo(0, groundY); ctx.closePath(); ctx.fill(); ctx.globalAlpha = 1;\n    \n    ctx.fillStyle = activeTheme.ground; ctx.fillRect(0, groundY, VIRTUAL_W, VIRTUAL_H - groundY);\n    ctx.fillStyle = activeTheme.groundLine; ctx.fillRect(0, groundY, VIRTUAL_W, 2);\n    const tickCount = Math.max(22, Math.round(VIRTUAL_W / 32)), base = (distance / 4) % (VIRTUAL_W / tickCount);\n    ctx.globalAlpha = activeTheme.tickAlpha; ctx.fillStyle = activeTheme.groundLine;\n    for (let i=0; i<tickCount; i++) ctx.fillRect(i*(VIRTUAL_W/tickCount)-base, groundY+10, 22, 2);\n    ctx.globalAlpha = 1;\n  }\n  function drawPalms(dt) {\n    ctx.globalAlpha = activeTheme.palmAlpha; ctx.fillStyle = \"#111\";\n    for (const p of palms) {\n      if (playing && !paused && !gameOver) p.x -= speed * dt * p.parallax;\n      if (p.x < -80) { p.x = VIRTUAL_W + rand(40, 220); p.size = rand(26, 44); p.parallax = rand(0.35, 0.6); }\n      ctx.fillRect(p.x, groundY-p.size, 6, p.size); ctx.beginPath(); ctx.moveTo(p.x+3, groundY-p.size); ctx.lineTo(p.x-18, groundY-p.size+10); ctx.lineTo(p.x+3, groundY-p.size+12); ctx.closePath(); ctx.fill(); ctx.beginPath(); ctx.moveTo(p.x+3, groundY-p.size); ctx.lineTo(p.x+26, groundY-p.size+8); ctx.lineTo(p.x+3, groundY-p.size+12); ctx.closePath(); ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n  }\n  function drawDust(dt) {\n    ctx.globalAlpha = activeTheme.dustAlpha; ctx.fillStyle = \"#111\";\n    for (let i = dust.length-1; i >= 0; i--) {\n      const d = dust[i]; if (playing && !paused && !gameOver) { d.life -= dt; d.vy += 600*dt; d.x += d.vx*dt; d.y += d.vy*dt; }\n      ctx.fillRect(d.x, d.y, 3, 3); if (d.life <= 0) dust.splice(i, 1);\n    }\n    ctx.globalAlpha = 1;\n  }\n  function drawPyramids(dt) {\n    for (let i = pyramids.length-1; i >= 0; i--) {\n      const p = pyramids[i]; if (playing && !paused && !gameOver) p.x -= speed*dt;\n      const w = p.size*p.widthMul, h = p.size, x = p.x, y = p.baseY;\n      ctx.fillStyle = activeTheme.pyramidFill; ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x+w/2, y-h); ctx.lineTo(x+w, y); ctx.closePath(); ctx.fill();\n      ctx.fillStyle = `rgba(0,0,0,${activeTheme.pyramidShadeAlpha})`; ctx.beginPath(); ctx.moveTo(x+w/2, y-h); ctx.lineTo(x+w, y); ctx.lineTo(x+w/2, y); ctx.closePath(); ctx.fill();\n      ctx.strokeStyle = activeTheme.pyramidOutline; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x+w/2, y-h); ctx.lineTo(x+w, y); ctx.stroke();\n      if (p.x+w < -60) pyramids.splice(i, 1);\n    }\n  }\n  \n  function drawBirds(dt) {\n    ctx.fillStyle = activeTheme.bird;\n    for (let i = birds.length-1; i >= 0; i--) {\n      const b = birds[i]; \n      if (playing && !paused && !gameOver) { \n        b.x -= speed * dt; \n        b.flap += dt * 10; \n      }\n      const wingUp = (Math.floor(b.flap)%2) === 0;\n      ctx.fillRect(b.x, b.y, b.w, b.h); ctx.fillRect(b.x+b.w, b.y+5, 6, 3);\n      if (wingUp) { ctx.fillRect(b.x+8, b.y-6, 10, 6); ctx.fillRect(b.x+18, b.y-8, 10, 8); } else { ctx.fillRect(b.x+8, b.y+b.h, 10, 6); ctx.fillRect(b.x+18, b.y+b.h, 10, 8); }\n      if (b.x+b.w < -80) birds.splice(i, 1);\n    }\n  }\n\n  function drawCenteredOverlay(text1, text2) {\n    ctx.save(); ctx.globalAlpha = 0.75; ctx.fillStyle = \"#fff\"; ctx.fillRect(0, 0, VIRTUAL_W, VIRTUAL_H); ctx.globalAlpha = 1; ctx.fillStyle = \"#111\";\n    ctx.font = \"700 28px 'Poppins', sans-serif\"; \n    ctx.fillText(text1, VIRTUAL_W/2 - ctx.measureText(text1).width/2, 140);\n    ctx.font = \"14px 'Poppins', sans-serif\"; \n    ctx.fillText(text2, VIRTUAL_W/2 - ctx.measureText(text2).width/2, 165);\n    ctx.restore();\n  }\n\n  function render(dt) {\n    resizeBackingStore(); \n    ctx.setTransform(1,0,0,1,0,0); \n    ctx.clearRect(0, 0, canvas.width, canvas.height); \n    ctx.setTransform(backingStoreScale, 0, 0, backingStoreScale, 0, 0);\n\n    canvas.style.background = activeTheme.sky;\n    drawBackground(); drawPalms(dt); drawDust(dt); drawPyramids(dt); drawBirds(dt); drawRunner(dt);\n    if (paused) drawCenteredOverlay(\"PAUSED\", \"Drücke P zum Fortsetzen\");\n    if (gameOver) drawCenteredOverlay(\"GAME OVER\", \"Space / Enter zum Neustarten\");\n  }\n\n  // ====== Update ======\n  function endGame() {\n    gameOver = true; playing = false; setBestIfNeeded(); render(0); stopLoop();\n  }\n\n  function update(dt) {\n    if (!playing || paused || gameOver) return;\n    speed += speedInc * dt; distance += speed * dt; score = Math.floor(distance / 10); scoreEl.textContent = score;\n    updateTheme(dt, score);\n    if (jumpBuffer > 0) jumpBuffer = Math.max(0, jumpBuffer - dt);\n    const g = gravity * ((!player.onGround && ducking) ? FALL_BOOST : 1.0);\n    player.vy += g * dt; player.y += player.vy * dt;\n    const wasOnGround = player.onGround;\n    if (player.y >= groundY) { player.y = groundY; player.vy = 0; player.onGround = true; coyote = COYOTE_MAX; } else { player.onGround = false; coyote = Math.max(0, coyote - dt); }\n    const canJump = player.onGround || coyote > 0;\n    if (jumpBuffer > 0 && canJump) {\n      player.vy = jumpVel; player.onGround = false; coyote = 0; jumpBuffer = 0;\n      for (let i = 0; i < 6; i++) dust.push({ x: player.x+10, y: groundY-4, vx: rand(-80, 40), vy: rand(-180, -60), life: rand(0.2, 0.35) });\n    }\n    if (wasOnGround && !player.onGround) coyote = COYOTE_MAX;\n    \n    pyramidTimer -= dt; \n    if (pyramidTimer <= 0) { \n      spawnPyramid(); \n      pyramidTimer = rand(pyramidEveryMin, pyramidEveryMax) / Math.min(1.8, speed / 430); \n    }\n    \n    if (score >= 250) { \n      birdTimer -= dt; \n      if (birdTimer <= 0) { \n        spawnBird(); \n        birdTimer = rand(birdEveryMin, birdEveryMax) / Math.min(1.6, speed / 430); \n      } \n    }\n\n    // --- Die Kommentare ---\n    if (score === 750 && !player.comment && player.lastCommentScore !== 750) { \n      player.comment = \"Easy win...\"; \n      player.commentTimer = 4; \n      player.lastCommentScore = 750; \n    }\n    else if (score === 1750 && !player.comment && player.lastCommentScore !== 1750) { \n      player.comment = \"Wowww... es ist schon dunkel!\"; \n      player.commentTimer = 4; \n      player.lastCommentScore = 1750; \n    }\n    else if (score === 3250 && !player.comment && player.lastCommentScore !== 3250) { \n      player.comment = \"Ähh... wo... wollen wir aufhören?\"; \n      player.commentTimer = 4; \n      player.lastCommentScore = 3000; \n    }\n\n    if (player.commentTimer > 0) {\n      player.commentTimer -= dt;\n      if (player.commentTimer <= 0) player.comment = null;\n    }\n\n    for (const p of pyramids) if (collidesRunnerWithPyramid(lastRunnerRectForCollision, p)) { endGame(); return; }\n    for (const b of birds) if (rectsIntersect(lastRunnerRectForCollision, { x: b.x, y: b.y-8, w: b.w+8, h: b.h+16 })) { endGame(); return; }\n  }\n\n  function loop(now) {\n    rafId = requestAnimationFrame(loop);\n    const dt = Math.min(0.033, (now - tPrev) / 1000); tPrev = now;\n    update(dt); render(dt);\n  }\n\n  resetToStartScreen();\n})();\n</script></b></b>",
