        "liquid_mPFTMh": {
          "type": "liquid",
          "name": "Inventarstatus",
          "settings": {
            "liquid": "<div class=\"canpan-inventory-status-container\">\n  {%- for variant in product.variants -%}\n    {%- assign is_hidden = true -%}\n    {%- if product.selected_or_first_available_variant.id == variant.id -%}\n      {%- assign is_hidden = false -%}\n    {%- endif -%}\n\n    {%- if variant.available -%}\n      {%- if variant.inventory_management == 'shopify' and variant.inventory_quantity <= 5 and variant.inventory_quantity > 0 -%}\n        <span class=\"canpan-inventory-status canpan-status-warning\" {% if is_hidden %}hidden{% endif %} data-variant-id=\"{{ variant.id }}\">\n          <span class=\"canpan-pulse-dot\"></span>\n          Nur {{ variant.inventory_quantity }} verfügbar! Jetzt bestellen\n        </span>\n      {%- else -%}\n        <span class=\"canpan-inventory-status canpan-status-success\" {% if is_hidden %}hidden{% endif %} data-variant-id=\"{{ variant.id }}\">\n          <span class=\"canpan-pulse-dot\"></span>\n          Sofort verfügbar! In 3-5 Tagen bei dir\n        </span>\n      {%- endif -%}\n    {%- else -%}\n      <span class=\"canpan-inventory-status canpan-status-error\" {% if is_hidden %}hidden{% endif %} data-variant-id=\"{{ variant.id }}\">\n        <span class=\"canpan-pulse-dot\"></span>\n        Nicht auf Lager\n      </span>\n    {%- endif -%}\n  {%- endfor -%}\n</div>"
          }
        },
