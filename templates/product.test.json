        "liquid_xfH8YV": {
          "type": "liquid",
          "name": "Kleine Vertrauensblöcke",
          "settings": {
            "liquid": "{%- comment -%}\n  Canpan Trust Blocks - Rendert Metaobject-Liste aus Varianten-Metafeldern.\n  Optimiert auf null Layout-Shifts und sofortiges Laden (Above the Fold).\n{%- endcomment -%}\n\n{%- assign canpan_current_variant = product.selected_or_first_available_variant -%}\n{%- assign canpan_trust_blocks = canpan_current_variant.metafields.custom_variant.trust_blocks.value -%}\n\n{%- if canpan_trust_blocks != blank -%}\n  <canpan-trust-blocks class=\"canpan-trust-blocks-wrapper\" data-variant-id=\"{{ canpan_current_variant.id }}\">\n    <ul class=\"canpan-trust-blocks-list\" role=\"list\">\n      {%- for canpan_block in canpan_trust_blocks -%}\n        <li class=\"canpan-trust-blocks-item\">\n          {%- if canpan_block.icon != blank -%}\n            <div class=\"canpan-trust-blocks-icon\">\n              {%- comment -%}\n                Bro, merk dir: Bilder unterm Buy-Button MÜSSEN eager geladen werden. \n                Und explicit Width/Height ist Pflicht für einen sauberen CLS-Score.\n              {%- endcomment -%}\n              {{- canpan_block.icon | image_url: width: 36 | image_tag: class: 'canpan-trust-icon-img', width: 18, height: 18, loading: 'eager', fetchpriority: 'high', alt: canpan_block.title -}}\n            </div>\n          {%- endif -%}\n          \n          {%- if canpan_block.title != blank -%}\n            <span class=\"canpan-trust-blocks-title\">{{ canpan_block.title }}</span>\n          {%- endif -%}\n        </li>\n      {%- endfor -%}\n    </ul>\n  </canpan-trust-blocks>\n\n  <style>\n    /* Styling passend zur Impact-Architektur, ohne unnötigen Bloat */\n    .canpan-trust-blocks-wrapper {\n      display: block;\n      /* Wir hebeln den Flex/Grid-Gap des Impact-Themes aus. \n        -1rem (entspricht meist 16px) ist sauberer als hardcodierte Pixel-Werte.\n      */\n      margin-top: -1rem; \n      margin-bottom: 0.5rem; \n    }\n\n    .canpan-trust-blocks-list {\n      display: flex;\n      flex-wrap: wrap;\n      /* Gap etwas verkleinert, damit es kompakter wirkt, wie auf deinem Screenshot */\n      gap: 8px 16px; \n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n\n    .canpan-trust-blocks-item {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .canpan-trust-blocks-icon {\n      flex-shrink: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .canpan-trust-icon-img {\n      width: 18px;\n      height: 18px;\n      object-fit: contain;\n      display: block;\n    }\n\n    .canpan-trust-blocks-title {\n      font-size: 0.8125rem; /* 13px - etwas kleiner für den kompakten Look */\n      color: var(--text-color);\n      line-height: 1.2;\n      font-weight: 500;\n    }\n  </style>\n{%- endif -%}"
          }
        },
        "liquid_hC7Tba": {
          "type": "liquid",
          "name": "Besondere Kunden",
          "disabled": true,
          "settings": {
            "liquid": "{%- assign sp_name_1 = shop.metafields.custom_shop.socialproof_name_1.value | default: \"\" | strip -%}\n{%- assign sp_name_2 = shop.metafields.custom_shop.socialproof_name_2.value | default: \"\" | strip -%}\n\n{%- assign sp_img_1 = shop.metafields.custom_shop.socialproof_image_1.value -%}\n{%- assign sp_img_2 = shop.metafields.custom_shop.socialproof_image_2.value -%}\n\n{%- assign show_1 = false -%}\n{%- assign show_2 = false -%}\n\n{%- if sp_name_1 != blank and sp_img_1 != blank -%}\n  {%- assign show_1 = true -%}\n{%- endif -%}\n\n{%- if sp_name_2 != blank and sp_img_2 != blank -%}\n  {%- assign show_2 = true -%}\n{%- endif -%}\n\n{%- if show_1 or show_2 -%}\n  <div class=\"canpan-socialproof\">\n    <div class=\"canpan-socialproof-images\">\n\n      <div class=\"canpan-verified-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\">\n          <polygon class=\"canpan-svg-icon-bg\" points=\"29.62,3 33.053,8.308 39.367,8.624 39.686,14.937 44.997,18.367 42.116,23.995 45,29.62 39.692,33.053 39.376,39.367 33.063,39.686 29.633,44.997 24.005,42.116 18.38,45 14.947,39.692 8.633,39.376 8.314,33.063 3.003,29.633 5.884,24.005 3,18.38 8.308,14.947 8.624,8.633 14.937,8.314 18.367,3.003 23.995,5.884\"></polygon>\n          <polygon class=\"canpan-svg-icon-check\" points=\"21.396,31.255 14.899,24.76 17.021,22.639 21.428,27.046 30.996,17.772 33.084,19.926\"></polygon>\n        </svg>\n      </div>\n\n      {%- if show_1 -%}\n        <span class=\"canpan-socialproof-img-wrap\">\n          {{ sp_img_1 | image_url: width: 80 | image_tag: \n            class: 'canpan-socialproof-img', \n            loading: 'lazy', \n            decoding: 'async', \n            alt: sp_name_1 \n          }}\n        </span>\n      {%- endif -%}\n\n      {%- if show_2 -%}\n        <span class=\"canpan-socialproof-img-wrap\">\n          {{ sp_img_2 | image_url: width: 80 | image_tag: \n            class: 'canpan-socialproof-img', \n            loading: 'lazy', \n            decoding: 'async', \n            alt: sp_name_2 \n          }}\n        </span>\n      {%- endif -%}\n\n    </div>\n\n    <div class=\"canpan-socialproof-text\">\n      <span>\n        {%- if show_1 and show_2 -%}\n          <span class=\"canpan-highlight\">{{ sp_name_1 }}, {{ sp_name_2 }}</span>\n        {%- elsif show_1 -%}\n          <span class=\"canpan-highlight\">{{ sp_name_1 }}</span>\n        {%- elsif show_2 -%}\n          <span class=\"canpan-highlight\">{{ sp_name_2 }}</span>\n        {%- endif -%}\n        und <span class=\"canpan-highlight\">viele weitere</span> sind Kunden!\n      </span>\n    </div>\n  </div>\n{%- endif -%}"
          }
        },
