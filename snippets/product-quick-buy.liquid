{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PRODUCT QUICK BUY
----------------------------------------------------------------------------------------------------------------------

This component is used to render the quick buy content. It is important to note that this snippet must always be
included inside a product template (you can find an example in the "main-product.liquid" section). The reason is that
we want to re-use the settings of the merchant on their product page (which info they want to make it visible). To do
that, we need to re-use the whole product page, and extract the quick-buy part (rendered here).

********************************************
Supported variables
********************************************

* product: the product to render
* section: the section is implicitly available. Here, the section is always a "product" template section, so you can
           access all the information from the section
{%- endcomment -%}

<template id="quick-buy-content">
  {%- capture product_form_id -%}quick-buy-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}
  {%- assign canpan_quick_buy_scope_id = 'canpan-quick-buy-' | append: product.id | append: '-' | append: section.id -%}
  {%- assign canpan_quick_buy_variant = product.selected_or_first_available_variant -%}
  {%- assign canpan_quick_buy_app = blank -%}
  {%- assign canpan_quick_buy_cta_button_background_color = blank -%}
  {%- assign canpan_quick_buy_cta_button_text_color = blank -%}
  {%- assign canpan_quick_buy_scope_style = blank -%}

  {%- if canpan_quick_buy_variant != blank and canpan_quick_buy_variant.metafields.custom_variant.page_appearance != blank -%}
    {%- assign canpan_quick_buy_app = canpan_quick_buy_variant.metafields.custom_variant.page_appearance.value -%}
    {%- assign canpan_quick_buy_cta_button_background_color = canpan_quick_buy_app.cta_button_background_color.value | strip -%}
    {%- assign canpan_quick_buy_cta_button_text_color = canpan_quick_buy_app.cta_button_text_color.value | strip -%}
  {%- endif -%}

  {%- capture canpan_quick_buy_scope_style -%}
    {%- if canpan_quick_buy_app != blank -%}
      {%- if canpan_quick_buy_cta_button_background_color != blank -%}--canpan-cta-button-background-color: {{ canpan_quick_buy_cta_button_background_color }};{%- endif -%}
      {%- if canpan_quick_buy_cta_button_text_color != blank -%}--canpan-cta-button-text-color: {{ canpan_quick_buy_cta_button_text_color }};{%- endif -%}
    {%- endif -%}
  {%- endcapture -%}

  <product-rerender id="{{ canpan_quick_buy_scope_id }}" class="canpan-product-theme-scope" observe-form="{{ product_form_id }}"{% if canpan_quick_buy_scope_style != blank %} style="{{ canpan_quick_buy_scope_style | strip }}"{% endif %}>
    {%- comment -%} CANPAN QoL PRE-LAUNCH – Scope the quick buy variant colors and CTA fallback logic directly inside each drawer instance {%- endcomment -%}
    <style>
      #{{ canpan_quick_buy_scope_id }} :is(.button, .shopify-payment-button__button:not(.shopify-payment-button__button--branded)):not([disabled]) {
        --canpan-quick-buy-button-background: var(--canpan-cta-button-background-color, rgb(var(--button-background, var(--button-background-primary))));
        --canpan-quick-buy-button-text-color: var(--canpan-cta-button-text-color, rgb(var(--button-text-color, var(--button-text-primary))));
        --canpan-quick-buy-button-hover-background: color-mix(in srgb, var(--canpan-quick-buy-button-background), white 12%);
        background-color: var(--canpan-quick-buy-button-background) !important;
        color: var(--canpan-quick-buy-button-text-color) !important;
        border-color: var(--canpan-quick-buy-button-background) !important;
        box-shadow: inset 0 0 0 2px var(--canpan-quick-buy-button-background) !important;
      }

      @media screen and (pointer: fine) {
        #{{ canpan_quick_buy_scope_id }} :is(.button, .shopify-payment-button__button:not(.shopify-payment-button__button--branded)):not([disabled]):hover {
          background-color: var(--canpan-quick-buy-button-hover-background) !important;
          color: var(--canpan-quick-buy-button-text-color) !important;
          border-color: var(--canpan-quick-buy-button-hover-background) !important;
          box-shadow: inset 0 0 0 2px var(--canpan-quick-buy-button-hover-background) !important;
        }
      }
    </style>

    <div slot="header" class="v-stack gap-4">
      <div class="quick-buy-drawer__variant text-start h-stack gap-6">
        {%- assign image = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

        {%- if image != blank -%}
          <variant-media widths="80,160" form="{{ product_form_id }}">
            {{- image | image_url: width: image.width | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', class: 'quick-buy-drawer__media rounded-xs' -}}
          </variant-media>
        {%- endif -%}

        {%- comment -%} CANPAN QoL PRE-LAUNCH – flex: 1; hinzugefügt, um Elemente korrekt an den rechten Rand zu schieben {%- endcomment -%}
        <div class="v-stack gap-0.5" style="min-width: 0; flex: 1;">
          {%- comment -%} CANPAN QoL PRE-LAUNCH –Quick-Buy-Header-Titel an den Custom-Titel der ausgewählten Variante anpassen {%- endcomment -%}
          {%- assign canpan_quick_buy_title = product.title -%}

          {%- if canpan_quick_buy_variant != blank and canpan_quick_buy_variant.metafields.custom_variant.title.value != blank -%}
            {%- assign canpan_quick_buy_title = canpan_quick_buy_variant.metafields.custom_variant.title.value -%}
          {%- endif -%}

          <a href="{{ product.url }}" class="canpan-quick-buy-truncate bold justify-self-start">{{ canpan_quick_buy_title }}</a>

          {%- if canpan_quick_buy_variant != blank and canpan_quick_buy_variant.metafields.custom_variant.little_text.value != blank -%}
            <span class="canpan-quick-buy-little-text canpan-quick-buy-truncate text-sm text-subdued justify-self-start">{{ canpan_quick_buy_variant.metafields.custom_variant.little_text.value }}</span>
          {%- endif -%}

          {%- capture canpan_quick_buy_price_bubble_markup -%}
            {%- render 'canpan-price-bubble', product: product, variant: canpan_quick_buy_variant -%}
          {%- endcapture -%}

          {%- capture canpan_inline_price_bubble_markup -%}
            {%- if canpan_quick_buy_price_bubble_markup != blank -%}
              <div class="canpan-inline-price-bubble">
                {{- canpan_quick_buy_price_bubble_markup -}}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- comment -%} CANPAN QoL PRE-LAUNCH – flex-wrap hinzugefügt, um Overflows auf kleinen Geräten zu verhindern {%- endcomment -%}
          <div class="canpan-quick-buy-price-wrapper h-stack align-center gap-2 flex-wrap{% if canpan_inline_price_bubble_markup != blank %} canpan-price-has-bubble{% endif %}" style="width: 100%;">
            {%- render 'price-list', product: product, variant: canpan_quick_buy_variant, form_id: product_form_id, canpan_inline_bubble_markup: canpan_inline_price_bubble_markup -%}
            {%- render 'product-badges', product: product, variant: canpan_quick_buy_variant, types: 'discount', context: 'product', class: 'canpan-quick-buy-discount-badge' -%}
          </div>
        </div>
      </div>

      {%- comment -%} CANPAN QoL PRE-LAUNCH – Inventory Status (Zurückgerollt auf DOM-Loop für lokales Custom JS) {%- endcomment -%}
      <div class="canpan-inventory-status-container text-start text-sm">
        {%- for variant in product.variants -%}
          {%- assign is_hidden = true -%}
          {%- if product.selected_or_first_available_variant.id == variant.id -%}
            {%- assign is_hidden = false -%}
          {%- endif -%}

          {%- if variant.available -%}
            {%- if variant.inventory_management == 'shopify' and variant.inventory_quantity <= 5 and variant.inventory_quantity > 0 -%}
              <span class="canpan-inventory-status canpan-status-warning" {% if is_hidden %}hidden{% endif %} data-variant-id="{{ variant.id }}">
                <span class="canpan-pulse-dot"></span>
                Nur {{ variant.inventory_quantity }} verfügbar! Jetzt bestellen
              </span>
            {%- else -%}
              <span class="canpan-inventory-status canpan-status-success" {% if is_hidden %}hidden{% endif %} data-variant-id="{{ variant.id }}">
                <span class="canpan-pulse-dot"></span>
                Sofort verfügbar! In 3-5 Tagen bei dir
              </span>
            {%- endif -%}
          {%- else -%}
            <span class="canpan-inventory-status canpan-status-error" {% if is_hidden %}hidden{% endif %} data-variant-id="{{ variant.id }}">
              <span class="canpan-pulse-dot"></span>
              Nicht auf Lager
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <hr class="canpan-quick-buy-separator">

    <div class="quick-buy-drawer__info">
      {%- comment -%}We only show a limited set of information in the quick buy{%- endcomment -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {%- comment -%} CANPAN QoL PRE-LAUNCH – App-Blöcke im Quick-Buy auslassen. Judge.me Preview-Badge kann hier leer rendern und nur vertikalen Abstand hinterlassen {%- endcomment -%}
            

          {%- when 'variant_picker' -%}
            <div class="canpan-quick-buy-variants-left text-start">
              {%- render 'variant-picker', product: product, form_id: product_form_id, update_url: false, hide_sold_out_variants: block.settings.hide_sold_out_variants, hide_size_chart: true, force_dropdown_as_block: true, block: block -%}
            </div>

          {%- when 'line_item_property' -%}
            {%- if block.settings.label != blank -%}
              {%- capture name -%}properties[{{ block.settings.label | escape }}]{%- endcapture -%}
  
              <div class="product-info__property">
                {%- if block.settings.type == 'text' -%}
                  {%- if block.settings.allow_long_text -%}
                    {%- render 'input', label: block.settings.label, name: name, form: product_form_id, multiline: 4, required: block.settings.required, maxlength: block.settings.max_length -%}
                  {%- else -%}
                    {%- render 'input', type: 'text', label: block.settings.label, name: name, form: product_form_id, required: block.settings.required, maxlength: block.settings.max_length -%}
                  {%- endif -%}
          
                {%- else -%}
                  {%- render 'checkbox', label: block.settings.label, name: name, required: block.settings.required, form: product_form_id -%}
                {%- endif -%}
              </div>
            {%- endif -%}
       
          {%- when 'buy_buttons' -%}
            {%- comment -%} CANPAN QoL PRE-LAUNCH – button_size explizit auf 'base' gesetzt, da Impact sonst auf 'xl' zurückfällt {%- endcomment -%}
            {%- render 'buy-buttons', product: product, form_id: product_form_id, show_payment_button: block.settings.show_payment_button, button_size: 'base' -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </product-rerender>
</template>
